# --- Supply-chain hardening -------------------------------------------------
# Block dependency lifecycle scripts (preinstall / install / postinstall).
#
# Self-replicating npm worms (e.g. the 2025 "Shai-Hulud" waves) work by publishing a
# compromised version of a popular package whose INSTALL SCRIPT runs automatically the moment
# you `npm install`. It harvests credentials (npm/GitHub tokens, cloud keys, env vars) and
# republishes itself onward. Refusing to run those scripts removes that entry point.
#
# Verified safe for this project: no build or test tool needs an install script. The native
# tools (Rolldown, Lightning CSS, the TypeScript 7 compiler) ship their binaries as per-platform
# optional packages. The one package in the lockfile that declares a script is fsevents (an
# optional macOS file watcher); it carries a prebuilt binary and works without it. Typecheck,
# all tests, the dev server and the PWA build pass on an `npm ci` tree with scripts off.
#
# If a future dependency genuinely needs its install script, don't disable this globally —
# read the script first, then install that one package deliberately:
#   npm install <pkg> --foreground-scripts
ignore-scripts=true

# Fail loudly rather than silently reaching the network for a missing/mismatched lockfile entry.
audit=true
fund=false
